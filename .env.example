# 백엔드 주소 (예: https://api.example.com). 비워 두면 같은 출처의 /api/v1을 호출한다.
# 쿠키(Refresh Token)를 받으려면 서버 CORS가 이 앱의 출처와 자격 증명(credentials)을 허용해야 한다.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
# Must match the current legal-document versions accepted by the API.
VITE_TERMS_VERSION=v1
VITE_PRIVACY_VERSION=v1
VITE_MARKETING_VERSION=v1
